{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node", "mdast-util-to-hast"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true
  },
  "include": ["vite.config.ts", "feed-plugin.ts", "src/content/post-parser.ts", "src/content/remark-kramdown-ial.ts"]
}
